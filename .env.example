# Copy ke .env dan isi nilai yang sesuai
# Semua nilai di config.json bisa di-override via env dengan prefix KREATIP_
# Contoh: KREATIP_DATABASE_PASSWORD=secret

KREATIP_APP_ENV=production
KREATIP_APP_PORT=8080

KREATIP_DATABASE_HOST=localhost
KREATIP_DATABASE_PORT=5432
KREATIP_DATABASE_USER=postgres
KREATIP_DATABASE_PASSWORD=change-me
KREATIP_DATABASE_NAME=kreatip

KREATIP_REDIS_ADDR=localhost:6379

KREATIP_JWT_SECRET=change-me-very-long-random-string

KREATIP_XENDIT_SECRET_KEY=xnd_production_...
KREATIP_XENDIT_WEBHOOK_TOKEN=...
KREATIP_XENDIT_CALLBACK_URL=https://api.kreatip.id/api/v1/webhooks/xendit

KREATIP_EMAIL_PROVIDER=resend
KREATIP_EMAIL_API_KEY=re_...
KREATIP_EMAIL_FROM=noreply@kreatip.id

KREATIP_STORAGE_ENDPOINT=https://...
KREATIP_STORAGE_BUCKET=kreatip
KREATIP_STORAGE_ACCESS_KEY=...
KREATIP_STORAGE_SECRET_KEY=...
KREATIP_STORAGE_PUBLIC_URL=https://cdn.kreatip.id
